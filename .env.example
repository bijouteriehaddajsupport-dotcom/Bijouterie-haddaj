# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : uniquement pour le script create-admin (ne jamais l'exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (utilisée pour les liens de confirmation e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Devise affichée (code ISO 4217)
NEXT_PUBLIC_CURRENCY=MAD

# Compte administrateur créé par `npm run create-admin`
ADMIN_EMAIL=bijouterie.haddaj.support@gmail.com
ADMIN_PASSWORD=

# E-mails de confirmation de commande (mot de passe d'application Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bijouterie.haddaj.support@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Haddaj Bijouterie
